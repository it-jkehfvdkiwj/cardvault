POKEMON_TCG_API_KEY=your_api_key_here
DATABASE_URL=sqlite:///./cardvault.db
UPLOAD_DIR=uploads
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Environment ───────────────────────────────────────────────────────────────
# "development" (default locally) or "production". In production the app refuses
# to start with an insecure JWT_SECRET or a wildcard CORS_ORIGINS. It also
# auto-detects production on Render/Fly/Railway or when CORS_ORIGINS/APP_BASE_URL
# point at a real https:// host, so forgetting this var can't silently downgrade
# your security.
APP_ENV=development

# ── Geschlossene Testphase ────────────────────────────────────────────────────
# true  = nur Leute mit Einladungscode können ein Konto anlegen, und Suchmaschinen
#         werden komplett ausgesperrt (X-Robots-Tag + robots.txt).
# false = öffentlich, jeder kann sich registrieren.
# Standard ist true, damit ein frisches Deployment nie versehentlich offen steht.
PRIVATE_BETA=true
# Kommagetrennte Einladungscodes. Ohne diese kann sich niemand registrieren
# (außer den Adressen in ADMIN_EMAILS — die kommen immer rein).
INVITE_CODES=

# Max size of a single uploaded image / whole request, in MB.
MAX_UPLOAD_MB=25
MAX_REQUEST_MB=200
# Set to false to disable login/upload rate limiting (local load tests only).
RATE_LIMIT_ENABLED=true

# ── Auth ──────────────────────────────────────────────────────────────────────
# Secret used to sign login tokens (JWT). CHANGE THIS to a long random string in
# production — anyone who knows it can forge logins. Generate one e.g. with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-insecure-secret-change-me-0123456789-abcdefghij
JWT_EXPIRE_DAYS=30

# Comma-separated emails that are auto-promoted to admin on login/register.
# Set this to YOUR email to unlock the Admin panel, then log in again.
ADMIN_EMAILS=quirin06@mail.de

# ── Billing / subscriptions ───────────────────────────────────────────────────
APP_BASE_URL=http://localhost:5173      # used for Stripe redirect URLs

# Launch phase: true = every Pro feature is unlocked for every account, with no
# payment and no Stripe account needed. Nothing is written to the database, so
# setting this to false later immediately restores the normal Free/Pro split.
FREE_LAUNCH=true

# The "upgrade myself to Pro without paying" button. Writes plan=pro straight
# into the DB, so it must stay false in production — use FREE_LAUNCH instead.
ALLOW_DEMO_BILLING=false
# Stripe (optional — fill to enable real card payments):
#   pip install stripe
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# ── Email (for password-reset mails) ──────────────────────────────────────────
# Without these, reset links are printed to the server console (dev convenience).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true

# Cardmarket API (optional – get credentials at developers.cardmarket.com)
# Without these, Cardmarket search and EUR prices from the CM API are disabled.
# EUR trend prices embedded in TCG API responses still work without these keys.
CM_APP_TOKEN=
CM_APP_SECRET=
CM_ACCESS_TOKEN=
CM_ACCESS_SECRET=

# ── OCR / scanning ────────────────────────────────────────────────────────────
# Path to the tesseract binary (only needed if not on the Windows default path).
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Folder containing eng.traineddata + deu.traineddata (bundled in backend/tessdata).
# TESSDATA_DIR=
# Languages used for card-name OCR (German first so umlauts read correctly).
# OCR_NAME_LANGS=deu+eng

# ── eBay CSV export defaults (no eBay account needed for CSV) ──────────────────
EBAY_SITE=DE                       # DE/AT/UK/US/FR/IT/ES
EBAY_CATEGORY=183454               # Pokémon Einzelkarten — VERIFY for your marketplace!
EBAY_FORMAT=FixedPrice
EBAY_DURATION=GTC
EBAY_LOCATION=Deutschland
EBAY_SHIPPING_SERVICE=DE_DeutschePostBrief
EBAY_SHIPPING_COST=1.80
EBAY_PRICE_MULTIPLIER=1.0          # 1.0 = Cardmarket trend price
EBAY_MIN_PRICE=0.99
EBAY_ROUND_99=true
USD_EUR_RATE=0.92                  # fallback when only a USD price is known

# ── eBay Sell API (OPTIONAL — only for direct live listing, see ebay_api_service) ─
# EBAY_ENV=production               # or "sandbox"
# EBAY_MARKETPLACE_ID=EBAY_DE
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
# EBAY_REFRESH_TOKEN=
