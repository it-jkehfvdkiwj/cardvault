# Copy to .env next to docker-compose.yml and fill in. Never commit the result.
#
# The app refuses to start in production if JWT_SECRET is missing or still the
# development default — that is intentional, not a bug.

# ── Welche Compose-Dateien gelten ─────────────────────────────────────────────
# Damit reicht auf dem Server ein schlichtes "docker compose ps", "docker compose
# logs" oder "docker compose up -d" — ohne jedes Mal beide -f-Flags anzuhängen.
# Ohne diese Zeile sieht Compose nur die Basisdatei und meldet für den
# TLS-Proxy "no such service: caddy".
COMPOSE_FILE=docker-compose.yml:docker-compose.caddy.yml

# ── Domain & HTTPS (für docker-compose.caddy.yml) ─────────────────────────────
# Die Domain, die per A-Record auf diesen Server zeigt — ohne https:// davor.
SITE_DOMAIN=deine-domain.de
# Adresse für Let's-Encrypt-Ablaufwarnungen.
ACME_EMAIL=quirin06@mail.de

# ── Required ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Your real domain, scheme included, no trailing slash.
APP_BASE_URL=https://deine-domain.de
CORS_ORIGINS=https://deine-domain.de
# Your email — unlocks the admin panel after the next login.
ADMIN_EMAILS=quirin06@mail.de

# ── Geschlossene Testphase ────────────────────────────────────────────────────
# Solange true: Registrierung nur mit Einladungscode, Suchmaschinen komplett
# ausgesperrt. Das ist der Modus für „nur ich und ein Freund testen".
PRIVATE_BETA=true
# Deine Codes, kommagetrennt. Denk dir etwas aus, das nicht zu erraten ist.
INVITE_CODES=

# ── Launch phase ──────────────────────────────────────────────────────────────
# true  = every Pro feature is free for everyone (no payment, no Stripe needed)
# false = plans are enforced; requires Stripe below
FREE_LAUNCH=true

# ── Database ──────────────────────────────────────────────────────────────────
# Default is SQLite in a docker volume. For Postgres, uncomment the db service in
# docker-compose.yml and use:
# DATABASE_URL=postgresql://cardvault:CHANGEME@db:5432/cardvault
# POSTGRES_PASSWORD=CHANGEME

# ── Optional: card data & prices ──────────────────────────────────────────────
# Free key from https://dev.pokemontcg.io — raises the rate limit noticeably.
POKEMON_TCG_API_KEY=

# ── Optional: password-reset emails ───────────────────────────────────────────
# Without SMTP the reset link is only printed to the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── Optional: Stripe (only needed when FREE_LAUNCH=false) ─────────────────────
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# ── Optional: durable photo storage (Cloudflare R2) ───────────────────────────
# Without these, sale photos live on the container filesystem and are lost on
# redeploy. See DEPLOY.md §5b.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# ── Uploads ───────────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=25
